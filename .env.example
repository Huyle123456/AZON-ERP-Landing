# -----------------------------------------------------------------------------
# AZOERP Landing — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# Anything prefixed with NEXT_PUBLIC_ is inlined into the client bundle;
# everything else stays server-side.
#
# For Vercel: set the same keys under Project → Settings → Environment
# Variables. Use Production / Preview / Development scopes as appropriate.
# -----------------------------------------------------------------------------

# Mattermost incoming webhook that receives sales-contact notifications from
# the /register (Standard / Enterprise) form. Get the URL from your Mattermost
# team → Integrations → Incoming Webhooks.
MATTERMOST_WEBHOOK_URL=https://work.example.com/hooks/xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backend base URL (must end with `/api/`). The Next.js proxy routes append
# the endpoint path (e.g. `tenant-requests`, `consultation-requests`,
# `tenant-requests/check-domain`). Set this to your staging / prod host.
API_URL=https://central.example.com/api/

# Base URL for the blog Posts CMS API. The proxy appends `/api/posts...`.
# Usually the same host as API_URL but without the /api/ suffix.
BLOG_API_URL=https://central.example.com

# Absolute site URL used for SEO canonicals, Open Graph tags, hreflang
# alternates and server-side fetches to our own /api/* routes.
# Locally: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com
